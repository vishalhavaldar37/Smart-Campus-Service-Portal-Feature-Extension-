@model SmartCampusPortal.Models.ServiceRequest
@{
    ViewBag.Title = "Delete Request";
}

<h2>Delete Service Request #@Model.RequestId</h2>
<div class="alert alert-error">Are you sure you want to delete this request? This cannot be undone.</div>

<div class="panel">
    <dl class="details">
        <dt>@Html.DisplayNameFor(m => m.StudentName)</dt><dd>@Model.StudentName</dd>
        <dt>@Html.DisplayNameFor(m => m.Department)</dt><dd>@Model.Department</dd>
        <dt>@Html.DisplayNameFor(m => m.ServiceType)</dt><dd>@Model.ServiceType</dd>
        <dt>@Html.DisplayNameFor(m => m.Description)</dt><dd>@Model.Description</dd>
        <dt>@Html.DisplayNameFor(m => m.Priority)</dt><dd>@Model.Priority</dd>
        <dt>@Html.DisplayNameFor(m => m.Status)</dt><dd>@Model.Status</dd>
    </dl>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Yes, Delete" class="btn btn-danger" />
    @Html.ActionLink("Cancel", "Index", new { }, new { @class = "btn btn-light" })
}
