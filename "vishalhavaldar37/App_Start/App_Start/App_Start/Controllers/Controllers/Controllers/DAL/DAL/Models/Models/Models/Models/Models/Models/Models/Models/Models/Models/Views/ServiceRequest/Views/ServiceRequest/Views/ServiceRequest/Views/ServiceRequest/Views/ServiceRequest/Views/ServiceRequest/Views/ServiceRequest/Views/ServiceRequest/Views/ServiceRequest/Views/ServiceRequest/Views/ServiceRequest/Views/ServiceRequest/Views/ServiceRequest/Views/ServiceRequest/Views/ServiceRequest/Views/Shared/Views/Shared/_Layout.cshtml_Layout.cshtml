<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Smart Campus Service Portal</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Segoe UI, Arial, sans-serif; background: #f3f5f9; color: #222; }
        header { background: #1f3a68; color: #fff; padding: 12px 24px; display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
        header .brand { font-size: 20px; font-weight: 600; }
        header nav a { color: #dbe6ff; text-decoration: none; margin-right: 16px; }
        header nav a:hover { color: #fff; text-decoration: underline; }
        main { max-width: 1150px; margin: 22px auto; padding: 0 16px; }
        footer { text-align: center; color: #777; font-size: 13px; padding: 18px; }
        h2 { margin-top: 0; }
        table { border-collapse: collapse; width: 100%; background: #fff; }
        th, td { border: 1px solid #d5dbe6; padding: 8px 10px; text-align: left; vertical-align: top; }
        th { background: #e8eef9; }
        input[type=text], textarea, select { width: 100%; max-width: 420px; padding: 7px; border: 1px solid #b9c3d6; border-radius: 4px; font: inherit; }
        textarea { height: 90px; }
        label { display: block; font-weight: 600; margin: 12px 0 4px; }
        .btn { display: inline-block; padding: 7px 16px; border: 0; border-radius: 4px; background: #1f3a68; color: #fff; text-decoration: none; cursor: pointer; font: inherit; }
        .btn:hover { background: #2c4f8f; }
        .btn-danger { background: #b3261e; }
        .btn-danger:hover { background: #d0342b; }
        .btn-light { background: #e3e8f2; color: #1f3a68; }
        .btn-light:hover { background: #d2daea; }
        .alert { background: #e4f5e8; border: 1px solid #9fd5ac; padding: 10px 14px; border-radius: 4px; margin-bottom: 16px; }
        .alert-error { background: #fdeaea; border-color: #e4a3a0; }
        .field-validation-error, .validation-summary-errors { color: #b3261e; }
        .validation-summary-errors ul { margin: 6px 0; }
        .muted { color: #666; }
        .cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
        .card { flex: 1 1 140px; background: #fff; border: 1px solid #d5dbe6; border-radius: 6px; padding: 12px 16px; }
        .card .num { font-size: 28px; font-weight: 700; color: #1f3a68; }
        .panel { background: #fff; border: 1px solid #d5dbe6; border-radius: 6px; padding: 14px 18px; margin-bottom: 18px; }
        .filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 14px; }
        .filters > div { display: flex; flex-direction: column; }
        .filters label { margin: 0 0 3px; font-size: 13px; }
        .badge { display: inline-block; padding: 2px 9px; border-radius: 10px; font-size: 12px; font-weight: 600; }
        .pending { background: #fff1cc; color: #7a5a00; }
        .inprogress { background: #d9eafe; color: #0b4c8c; }
        .completed { background: #d8f3de; color: #1b6b32; }
        .high { color: #b3261e; font-weight: 600; }
        .actions a { margin-right: 8px; }
        dl.details { display: grid; grid-template-columns: 170px 1fr; gap: 8px 12px; }
        dl.details dt { font-weight: 600; }
        dl.details dd { margin: 0; }
    </style>
</head>
<body>
    <header>
        <div class="brand">Smart Campus Service Portal</div>
        <nav>
            @Html.ActionLink("All Requests", "Index", "ServiceRequest")
            @Html.ActionLink("New Request", "Create", "ServiceRequest")
            @Html.ActionLink("API Dashboard", "Dashboard", "ServiceRequest")
        </nav>
    </header>
    <main>
        @if (TempData["Message"] != null)
        {
            <div class="alert">@TempData["Message"]</div>
        }
        @RenderBody()
    </main>
    <footer>Smart Campus Service Portal &middot; ASP.NET MVC 5 + SQL Server + Web API</footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
